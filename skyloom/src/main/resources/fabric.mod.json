{
  "schemaVersion": 1,
  "id": "skyloom",
  "version": "${version}",
  "name": "Skyloom",
  "description": "Swap the sky from an in-game menu. Loads OptiFine and MCPatcher custom sky packs, no reload and no resource pack juggling.",
  "authors": ["yxusuf05"],
  "contact": {
    "sources": "https://github.com/yxusuf05/skyloom"
  },
  "license": "MIT",
  "icon": "assets/skyloom/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.yxusuf05.skyloom.Skyloom"]
  },
  "mixins": ["skyloom.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
