# ===== ModForge Konfiguration =====
# Kopiere diese Datei nach .env und fülle die Werte aus.

# Port des Webservers
PORT=3000

# ---- KI-Backend (mindestens EINES konfigurieren) ----
# Variante A: Anthropic (beste Qualität, kostet pro Nutzung)
ANTHROPIC_API_KEY=

# Variante B: kostenloses lokales Modell über einen OpenAI-kompatiblen
# Endpoint, z.B. Ollama (https://ollama.com):
#   ollama pull qwen3-coder:30b   →   OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=ollama
OPENAI_COMPAT_MODEL=qwen3-coder:30b

# Modell pro Plan überschreiben (optional). provider: anthropic | openai-compat
# FREE_PROVIDER=anthropic
# FREE_MODEL=claude-haiku-4-5-20251001
# PREMIUM_PROVIDER=anthropic
# PREMIUM_MODEL=claude-sonnet-5

# ---- Builds ----
# Leer lassen = jeder Build nutzt den Gradle-Wrapper des Templates (empfohlen).
# Nur setzen, wenn der Host keine Gradle-Distribution herunterladen darf:
# MODFORGE_GRADLE=/usr/bin/gradle
# BUILD_TIMEOUT_MS=600000
# BUILD_CONCURRENCY=1
# KEEP_BUILD_DIRS=0

# ---- Stripe (Premium-Zahlungen; leer = Stub-Modus) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=

# Im Stub-Modus: 1 = Konto per POST /api/billing/dev-upgrade auf Premium schalten (nur lokal/testing!)
ALLOW_DEV_UPGRADE=0

# Datenverzeichnis (SQLite, Builds, Artefakte, Gradle-Cache)
# DATA_DIR=./data
