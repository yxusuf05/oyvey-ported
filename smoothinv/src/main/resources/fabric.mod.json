{
  "schemaVersion": 1,
  "id": "smoothinv",
  "version": "${version}",
  "name": "SmoothInv",
  "description": "Reduces inventory GUI stutter in PvP by caching item tooltips and cutting per-frame allocations. Helps most on low-RAM setups.",
  "authors": [
    "yxusuf05"
  ],
  "license": "MIT",
  "icon": "assets/smoothinv/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.smoothinv.SmoothInv"
    ]
  },
  "mixins": [
    "smoothinv.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
